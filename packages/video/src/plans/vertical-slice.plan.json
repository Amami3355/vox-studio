{
  "beats": [
    {
      "id": "b1",
      "text": "Across Europe's biggest cities, rent has climbed every year for a decade, and pay has not come close to keeping up."
    },
    {
      "id": "b2",
      "text": "Nowhere is that gap wider than in London, where a median income now loses almost half of itself to rent alone."
    },
    {
      "id": "b3",
      "text": "Berlin sits twenty points lower, and the distance between them keeps growing."
    },
    {
      "id": "b4",
      "text": "The squeeze is quietly deciding who can still afford to live in a city at all, and the answer is changing every year."
    }
  ],
  "sections": [
    {
      "id": "sec-rent",
      "spansBeats": ["b1", "b2", "b3", "b4"],
      "persistent": [
        {
          "id": "narrator",
          "element": "character",
          "assetRequirement": {
            "type": "character",
            "subject": "Narrator figure, flat editorial silhouette",
            "treatment": "illustration",
            "orientation": "square",
            "identityKey": "narrator"
          },
          "placements": [
            { "at": "b2.start", "slot": "cornerBR" },
            { "at": "b4.start", "slot": "left" }
          ]
        }
      ],
      "scenes": [
        {
          "id": "opening",
          "component": "image_context",
          "layout": "splitLeft",
          "motionProfile": "cinematic",
          "spansBeats": ["b1"],
          "props": {
            "headline": "A decade of rising rent",
            "caption": "Every year, a little more of a pay cheque disappears before the month begins.",
            "assetRequirement": {
              "type": "image",
              "subject": "Dense apartment buildings in a European city at dusk",
              "treatment": "photo",
              "orientation": "landscape",
              "identityKey": "housing-city-context"
            }
