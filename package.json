{
  "name": "vox-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "pnpm --filter @vox/video studio",
    "studio:app": "pnpm --filter @vox/studio dev",
    "studio:build": "pnpm --filter @vox/studio build",
    "studio:test": "pnpm --filter @vox/studio test:browser",
    "grid": "pnpm --filter @vox/component-studio dev",
    "catalog": "pnpm --filter @vox/video catalog && pnpm --filter @vox/production contracts",
    "catalog:check": "pnpm --filter @vox/video catalog:check && pnpm --filter @vox/production contracts:check",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:wizard": "node deploy/tests/excluded-from-context.test.mjs",
    "test:deploy": "node deploy/tests/cloud-deployment-contract.test.mjs",
    "test:render": "vitest run --config vitest.render.config.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "check": "biome check .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
