{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignore": [
      "**/dist",
      "**/node_modules",
      "**/.remotion",
      "packages/video/src/catalog/*.json",
      "packages/production/src/contracts/generated/*.json",
      "services/agents/tests/fixtures/artifacts/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": { "level": "warn", "options": { "allow": ["error", "warn", "info"] } }
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error"
      }
    }
  }
}
